#!/usr/bin/env bash
# Start Codex in this pane as the agrevloop author or reviewer:
#
#   agrevloop-codex author [<change-id or description> [gates=...] | review [<name>]] [-- codex args]
#   agrevloop-codex reviewer [-- codex args]
#
# Registers this pane in the mailbox first (the sandbox cannot reach agwinterm, so Codex could not
# do it itself), then runs Codex in a workspace-write sandbox rooted at the checkout, without
# network or approval prompts, and with the mailbox copied into its tool environment (Codex strips
# the environment from tool subprocesses). Arguments after `--` go to codex unchanged.
# The configurable status line is turned off: it draws a second footer row under the composer,
# and peer-chat, which strips exactly one, then refuses every ring as "no Codex composer visible".
set -euo pipefail

usage() { echo "usage: agrevloop-codex author|reviewer [skill args] [-- codex args]" >&2; exit 2; }

role="${1:-}"
case "$role" in author|reviewer) shift ;; *) usage ;; esac
skill_args=()
while [ $# -gt 0 ] && [ "$1" != "--" ]; do skill_args+=("$1"); shift; done
[ $# -gt 0 ] && shift
[ "$role" = reviewer ] && [ ${#skill_args[@]} -gt 0 ] && usage

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(git rev-parse --show-toplevel)"
workbench="${AGWORKBENCH:-$(cd "$here/../.." && pwd)/agworkbench}"
hub="$root/.agrevloop"

[ -f "$workbench/lib/agmsg.py" ] || { echo "agrevloop-codex: agworkbench not found at $workbench" >&2; exit 2; }

cd "$root"
python "$here/agr.py" --as "$role" init --tool codex

if [ "$role" = author ]; then
  prompt="You are the agrevloop AUTHOR. Load the agrevloop-author skill and run it with the arguments: ${skill_args[*]:-(none)}"
else
  prompt="You are the agrevloop REVIEWER. Load the agrevloop-reviewer skill, handle any unread mail from the author, then end your turn."
fi

win() { cygpath -m "$1"; }

exec codex \
  --sandbox workspace-write \
  --ask-for-approval never \
  -c sandbox_workspace_write.network_access=false \
  -c 'tui.status_line=[]' \
  -c "shell_environment_policy.set.AI_HUB='$(win "$hub")'" \
  -c "shell_environment_policy.set.AI_BOX='$role'" \
  -c "shell_environment_policy.set.AGWORKBENCH='$(win "$workbench")'" \
  "$@" \
  "$prompt"
