#!/usr/bin/env bash
# Start Codex as the agrevloop reviewer in this pane: workspace-write sandbox rooted at the
# checkout, no network, no approval prompts, and the mailbox copied into its tool environment
# (Codex strips the environment from tool subprocesses). Extra arguments go to codex unchanged.
# The configurable status line is turned off: it draws a second footer row under the composer,
# and peer-chat, which strips exactly one, then refuses every nudge as "no Codex composer visible".
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(git rev-parse --show-toplevel)"
workbench="${AGWORKBENCH:-$(cd "$here/../.." && pwd)/agworkbench}"
hub="$root/.agrevloop"

[ -f "$workbench/lib/agmsg.py" ] || { echo "agrevloop-codex: agworkbench not found at $workbench" >&2; exit 2; }
mkdir -p "$hub/reviews"

win() { cygpath -m "$1"; }

cd "$root"
exec codex \
  --sandbox workspace-write \
  --ask-for-approval never \
  -c sandbox_workspace_write.network_access=false \
  -c 'tui.status_line=[]' \
  -c "shell_environment_policy.set.AI_HUB='$(win "$hub")'" \
  -c "shell_environment_policy.set.AI_BOX='codex'" \
  -c "shell_environment_policy.set.AGWORKBENCH='$(win "$workbench")'" \
  "$@" \
  'You are the agrevloop REVIEWER. Load the agrevloop-reviewer skill, handle any unread mail from Claude, then wait for more.'
